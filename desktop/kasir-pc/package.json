{
  "name": "kasir-pc",
  "productName": "Kasir PC",
  "version": "1.0.0",
  "private": true,
  "description": "Kasir PC (Windows) untuk NTN Mart / Kuncen Mart - transaksi penjualan yang tetap jalan saat offline",
  "author": "NTN Mart",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite build && electron .",
    "icon": "electron scripts/make-icon.js",
    "dist": "vite build && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "vite": "8.3.8"
  },
  "build": {
    "appId": "com.ntnmart.kasirpc",
    "productName": "Kasir PC",
    "artifactName": "KasirPC-Setup-${version}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kasir PC",
      "deleteAppDataOnUninstall": false
    }
  }
}
